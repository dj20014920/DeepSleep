# ===== Project Specific Exclusions =====
# Keep important configuration files
!scripts/pipeline/config/*.yaml
!scripts/pipeline/data/*.json

# Keep essential tokenizer files
!scripts/pipeline/finetuning/ko-dialogpt_tokenizer.json

# Keep documentation
!README.md
!docs/*.md
!scripts/pipeline/README.md
!scripts/pipeline/REORGANIZATION_SUMMARY.md

# Keep essential scripts
!*.sh
!Makefile
!project.yml

# ===== Override Rules =====
# Force include essential files even if they match ignore patterns
!.gitignore
!.swiftlint.yml

