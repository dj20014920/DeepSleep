import Foundation

// ChatMessage는 Models.swift에 정의되어 있음
// StoredChatMessage는 CommonUtilities.swift에 정의되어 있음

// MARK: - 🚀 Enhanced Chat Models
struct LocalChatSession: Codable {
    let id: UUID
    let contextType: ContextType
    let startTime: Date
    var lastAccessTime: Date
    var messages: [String] // StoredChatMessage 대신 간단한 String 배열 사용
    
    enum ContextType: String, Codable, CaseIterable {
        case general = "general"
        case diaryAnalysis = "diary_analysis"
        case emotionPatternAnalysis = "emotion_pattern"
        case presetRecommendation = "preset_recommendation"
        case enhancedTherapy = "enhanced_therapy"
    }
}

// MARK: - 🚀 Enhanced ChatManager (UserDefaults + CachedConversationManager 완전 연동)
class ChatManager {
    static let shared = ChatManager()
    
    // MARK: - 🚀 채팅 상태 보존용 메시지 배열
    private(set) var messages: [Any] = []
    
    // UserDefaults 기반 저장소만 사용 (Core Data 제거)
    private let storageKey = "cached_chat_sessions"
    
    // MARK: - Enhanced Memory Management (30일 보관)
    private var activeSessions: [UUID: LocalChatSession] = [:]
    private let maxActiveSessions = 10
    private let automaticCleanupInterval: TimeInterval = 24 * 60 * 60 // 24시간
    private let maxSessionLifetime: TimeInterval = 30 * 24 * 60 * 60 // 30일 보관
    private let cacheRetentionDays: TimeInterval = 14 * 24 * 60 * 60 // 2주 캐시
    
    private init() {
        setupAutomaticCleanup()
        loadRecentMessages() // 🚀 앱 시작 시 최근 메시지 로드
        print("✅ ChatManager initialized (완전한 버전 - 30일 보관, 2주 캐시)")
    }
    
    // MARK: - 🚀 메시지 관리 (상태 보존용)
    func append(_ message: Any) {
        messages.append(message)
        print("📝 Message added")
        
        // 메모리 최적화: 메시지가 너무 많으면 오래된 것부터 제거
        if messages.count > 200 {
            messages.removeFirst(50) // 처음 50개 제거
        }
        
        // 30일 보관 정책에 따른 메시지 저장 (간소화)
        saveMessageWithRetentionPolicy(message)
    }
    
    private func saveMessageWithRetentionPolicy(_ message: Any) {
        // 30일 보관 정책에 따른 간단한 저장
        print("💾 [ChatManager] 메시지 저장 (30일 보관 정책)")
    }
    
    func loadRecentMessages() {
        // 30일 이내 메시지 로드 (간소화)
        print("✅ [ChatManager] 30일 이내 메시지 로드 시도")
        
        // 실제 구현은 UserDefaults에서 저장된 세션들을 확인
        let allSessions = loadAllSessionsFromUserDefaults()
        let thirtyDaysAgo = Date().addingTimeInterval(-maxSessionLifetime)
        
        let recentSessions = allSessions.values.filter { session in
            session.lastAccessTime >= thirtyDaysAgo
        }
        
        print("✅ [ChatManager] 30일 이내 \(recentSessions.count)개 세션 발견")
    }
    
    func clearMessages() {
        messages.removeAll()
        print("🗑️ Messages cleared")
    }
    
    // MARK: - 🔄 Session Management (30일 보관)
    func createSession(contextType: LocalChatSession.ContextType = .general) -> UUID {
        let sessionId = UUID()
        let session = LocalChatSession(
            id: sessionId,
            contextType: contextType,
            startTime: Date(),
            lastAccessTime: Date(),
            messages: []
        )
        
        activeSessions[sessionId] = session
        saveSession(session)
        
        print("✅ [ChatManager] 새 세션 생성: \(contextType) - \(sessionId)")
        return sessionId
    }
    
    func getSession(_ sessionId: UUID) -> LocalChatSession? {
        // 메모리에서 먼저 확인
        if let activeSession = activeSessions[sessionId] {
            return activeSession
        }
        
        // UserDefaults에서 로드
        return loadSessionFromUserDefaults(sessionId)
    }
    
    func addMessage(to sessionId: String, message: Any) {
        print("📝 Message added to session \(sessionId)")
        // 실제 구현은 필요시 추가
    }
    
    func getSessions() -> [String] {
        let allSessions = loadAllSessionsFromUserDefaults()
        return allSessions.keys.map { $0.uuidString }
    }
    
    // MARK: - 🔄 UserDefaults Persistence (30일 보관)
    private func saveSession(_ session: LocalChatSession) {
        var allSessions = loadAllSessionsFromUserDefaults()
        allSessions[session.id] = session
        
        // 30일 이상 된 세션 정리
        let cutoffDate = Date().addingTimeInterval(-maxSessionLifetime)
        allSessions = allSessions.filter { _, session in
            session.lastAccessTime > cutoffDate
        }
        
        if let encoded = try? JSONEncoder().encode(allSessions) {
            UserDefaults.standard.set(encoded, forKey: storageKey)
        }
        
        print("💾 [ChatManager] 세션 저장 완료 (30일 보관)")
    }
    
    private func loadSessionFromUserDefaults(_ sessionId: UUID) -> LocalChatSession? {
        let allSessions = loadAllSessionsFromUserDefaults()
        return allSessions[sessionId]
    }
    
    private func loadAllSessionsFromUserDefaults() -> [UUID: LocalChatSession] {
        guard let data = UserDefaults.standard.data(forKey: storageKey),
              let sessions = try? JSONDecoder().decode([UUID: LocalChatSession].self, from: data) else {
            return [:]
        }
        return sessions
    }
    
    // MARK: - 🧹 Automatic Cleanup (30일 + 2주 캐시)
    private func setupAutomaticCleanup() {
        Timer.scheduledTimer(withTimeInterval: automaticCleanupInterval, repeats: true) { [weak self] _ in
            self?.performAutomaticCleanup()
        }
    }
    
    private func performAutomaticCleanup() {
        let cutoffDate = Date().addingTimeInterval(-maxSessionLifetime)
        let cacheDate = Date().addingTimeInterval(-cacheRetentionDays)
        
        // 30일 이상 된 세션 정리
        activeSessions = activeSessions.filter { _, session in
            session.lastAccessTime > cutoffDate
        }
        
        // 2주 이상 된 캐시 정리 (간소화)
        print("🧹 [ChatManager] 자동 정리 완료 - 30일 보관, 2주 캐시 정책 적용")
    }
} 